# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=eventai
POSTGRES_PASSWORD=eventai
POSTGRES_DB=eventai
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# Used when running the API outside Docker (uvicorn on your machine).
# docker compose overrides these for the api/worker containers.
MIGRATION_DATABASE_URL=postgresql+asyncpg://eventai:eventai@localhost:5433/eventai
DATABASE_URL=postgresql+asyncpg://app_rw:app_rw_dev@localhost:5433/eventai
READONLY_DATABASE_URL=postgresql+asyncpg://app_readonly:app_readonly_dev@localhost:5433/eventai
# Passwords the migration sets for the two non-owner roles (must match the URLs above)
APP_RW_PASSWORD=app_rw_dev
APP_READONLY_PASSWORD=app_readonly_dev
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=480

# --- LLM (Google AI Studio free tier) ---
GEMINI_API_KEY=
# Confirm the current IDs in AI Studio; they change over time.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.5-flash

# --- Embeddings (local, fastembed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
